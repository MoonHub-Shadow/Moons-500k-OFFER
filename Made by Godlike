-- Fast Rebirth
local FastRebirthLoop = nil
local ToggleFastRebirth = TabAutoRebirth:CreateToggle({
    Name = "Auto Fast Rebirth",
    CurrentValue = false,
    Flag = "AutoFastRebirth",
    Callback = function(Value)
        if FastRebirthLoop then
            task.cancel(FastRebirthLoop)
            FastRebirthLoop = nil
        end

        if Value then
            FastRebirthLoop = task.spawn(function()
                local replicatedStorage = game:GetService("ReplicatedStorage")
                local players = game:GetService("Players")
                local localPlayer = players.LocalPlayer

                local function unequipAllPets()
                    local petsFolder = localPlayer:FindFirstChild("petsFolder")
                    if petsFolder then
                        for _, petFolder in pairs(petsFolder:GetChildren()) do
                            if petFolder:IsA("Folder") then
                                for _, pet in pairs(petFolder:GetChildren()) do
                                    pcall(function() replicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet) end)
                                end
                            end
                        end
                        task.wait(0.1)
                    end
                end

                local function equipPetByName(petName)
                    unequipAllPets()
                    task.wait(0.01)
                    local uniquePetsFolder = localPlayer:FindFirstChild("petsFolder") and localPlayer.petsFolder:FindFirstChild("Unique")
                    if uniquePetsFolder then
                        for _, pet in pairs(uniquePetsFolder:GetChildren()) do
                            if pet.Name == petName then
                                pcall(function() replicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet) end)
                                break -- Found and equipped, exit the inner loop
                            end
                        end
                    end
                end

                local function findMachine(machineName)
                    local machine = workspace.machinesFolder:FindFirstChild(machineName)
                    if not machine then
                        for _, folder in pairs(workspace:GetChildren()) do
                            if folder:IsA("Folder") and folder.Name:find("machines") then
                                machine = folder:FindFirstChild(machineName)
                                if machine then
                                    break
                                end
                            end
                        end
                    end
                    return machine
                end

                local function simulateKeyPress()
                    local virtualInputManager = game:GetService("VirtualInputManager")
                    virtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) -- Use Enum.KeyCode
                    task.wait(0.1)
                    virtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) -- Use Enum.KeyCode
                end

                while FastRebirthLoop do -- Loop as long as FastRebirthLoop is not nil
                    local leaderstats = localPlayer:FindFirstChild("leaderstats")
                    if not leaderstats or not leaderstats:FindFirstChild("Rebirths") or not leaderstats:FindFirstChild("Strength") then
                        warn("Leaderstats or required values not found for Fast Rebirth.")
                        task.wait(1) -- Wait a bit before checking again
                        continue
                    end

                    local rebirths = leaderstats.Rebirths.Value
                    local strengthThreshold = 10000 + (5000 * rebirths)

                    local ultimatesFolder = localPlayer:FindFirstChild("ultimatesFolder")
                    if ultimatesFolder and ultimatesFolder:FindFirstChild("Golden Rebirth") then
                        local goldenRebirthValueObject = ultimatesFolder["Golden Rebirth"]
                        if goldenRebirthValueObject and goldenRebirthValueObject:IsA("IntValue") then
                            local goldenRebirthValue = goldenRebirthValueObject.Value
                             -- Ensure goldenRebirthValue is a number before multiplication
                            if type(goldenRebirthValue) == 'number' then
                                strengthThreshold = math.floor(strengthThreshold * (1 - (goldenRebirthValue * 0.1)))
                            end
                        end
                    end

                    unequipAllPets()
                    task.wait(0.1)
                    equipPetByName("Swift Samurai")

                    while FastRebirthLoop and localPlayer.leaderstats.Strength.Value < strengthThreshold do
                        pcall(function() localPlayer.muscleEvent:FireServer("rep") end) -- Use pcall
                        task.wait()
                    end

                    if not FastRebirthLoop then break end -- Check if toggle was turned off

                    unequipAllPets()
                    task.wait(0.1)
                    equipPetByName("Tribal Overlord")

                    local jungleBarLift = findMachine("Jungle Bar Lift")
                    if jungleBarLift and jungleBarLift:FindFirstChild("interactSeat") then
                        localPlayer.Character.HumanoidRootPart.CFrame = jungleBarLift.interactSeat.CFrame * CFrame.new(0, 3, 0)
                        repeat
                            task.wait(0.1)
                            simulateKeyPress()
                        until not FastRebirthLoop or (localPlayer.Character and localPlayer.Character.Humanoid and localPlayer.Character.Humanoid.Sit) -- Check toggle state and if character is sitting

                        if not FastRebirthLoop then break end -- Check if toggle was turned off
                    else
                         warn("Jungle Bar Lift machine or seat not found for Fast Rebirth.")
                         -- Continue the loop, maybe try again or handle this case
                         task.wait(1)
                         continue
                    end

                    local initialRebirths = localPlayer.leaderstats.Rebirths.Value
                    repeat
                        pcall(function() replicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest") end) -- Use pcall
                        task.wait(0.1)
                    until not FastRebirthLoop or localPlayer.leaderstats.Rebirths.Value > initialRebirths -- Check toggle state and if rebirth occurred

                    if not FastRebirthLoop then break end -- Check if toggle was turned off

                    task.wait()
                end
                 -- If the loop stops naturally, uncheck the toggle
                 if FastRebirthLoop then
                     FastRebirthLoop = nil
                     -- Update UI toggle state
                 end
            end)
        end
    end,
})

