-- Helper function for creating toggles
local function createAutoActionToggle(tab, name)
    return tab:CreateToggle({
        Name = "Auto " .. name,
        CurrentValue = false,
        Flag = "Auto" .. name,
        Callback = function(Value)
            _G["Auto" .. name] = Value
            local player = game.Players.LocalPlayer
            local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
            local tool = player.Backpack:FindFirstChild(name) or player.Character:FindFirstChild(name) -- Check Character too

            if Value and tool then
                -- Equip tool
                if humanoid and not tool.Parent:IsA("Character") then -- Only equip if not already equipped
                    humanoid:EquipTool(tool)
                end
                -- Start auto action
                _G["Auto" .. name .. "Loop"] = task.spawn(function()
                    while _G["Auto" .. name] do
                        game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                        task.wait(0.001)
                    end
                end)
            else
                -- Unequip and stop loop
                _G["Auto" .. name] = false
                if _G["Auto" .. name .. "Loop"] then
                    task.cancel(_G["Auto" .. name .. "Loop"])
                    _G["Auto" .. name .. "Loop"] = nil
                end
                if humanoid and tool and tool.Parent:IsA("Character") then
                     -- Optional: Unequip the tool if you want it to go back to the backpack
                     -- humanoid:UnequipTool(tool)
                end
            end
        end
    })
end

