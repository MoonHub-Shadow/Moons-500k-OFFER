-- Helper function for creating toggles
local function createAutoActionToggle(tab, name)
    local autoActionLoop = nil -- Initialize loop variable for each toggle

    return tab:CreateToggle({
        Name = "Auto " .. name,
        CurrentValue = false,
        Flag = "Auto" .. name,
        Callback = function(Value)
            if autoActionLoop then
                task.cancel(autoActionLoop)
                autoActionLoop = nil
            end

            if Value then
                local player = game.Players.LocalPlayer
                local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
                local tool = player.Backpack:FindFirstChild(name) or (player.Character and player.Character:FindFirstChild(name)) -- Check Character too

                if tool then
                    -- Equip tool if not already equipped
                    if humanoid and not tool.Parent:IsA("Character") then
                        humanoid:EquipTool(tool)
                    end
                    -- Start auto action
                    autoActionLoop = task.spawn(function()
                        while autoActionLoop do -- Loop as long as autoActionLoop is not nil
                            -- Ensure the tool is still equipped before firing
                            if player.Character and player.Character:FindFirstChild(name) then
                                game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                            else
                                -- Tool unequipped, stop the loop
                                break
                            end
                            task.wait(0.001)
                        end
                         -- If the loop stops naturally (e.g., tool unequipped), uncheck the toggle
                        if autoActionLoop then
                            autoActionLoop = nil
                            -- You might want to update the UI toggle state here if Rayfield supports it
                            -- For example: Rayfield.SetToggleValue("Auto" .. name, false)
                        end
                    end)
                else
                    warn("Tool '" .. name .. "' not found in Backpack or Character.")
                     -- If tool not found, uncheck the toggle
                     if autoActionLoop then
                         autoActionLoop = nil
                         -- You might want to update the UI toggle state here
                     end
                end
            end
        end
    })
end

