local function createJungleMachineToggle(tab, name, position)
    local machineLoop = nil -- Initialize loop variable for each machine

    return tab:CreateToggle({
        Name = "Jungle Gym " .. name,
        CurrentValue = false,
        Flag = "Jungle" .. name,
        Callback = function(Value)
            if machineLoop then
                task.cancel(machineLoop)
                machineLoop = nil
            end

            if Value then
                machineLoop = task.spawn(function()
                    local player = game.Players.LocalPlayer
                    local machine = workspace.machinesFolder:FindFirstChild(name) -- Find the machine once

                    if not machine then
                        warn("Jungle machine '" .. name .. "' not found.")
                         -- If machine not found, stop the loop and uncheck toggle
                         if machineLoop then
                             task.cancel(machineLoop)
                             machineLoop = nil
                             -- Update UI toggle state
                         end
                        return
                    end

                    local interactSeat = machine:FindFirstChild("interactSeat")
                     if not interactSeat then
                         warn("Interact seat not found for machine '" .. name .. "'.")
                         -- Stop loop and uncheck toggle
                         if machineLoop then
                             task.cancel(machineLoop)
                             machineLoop = nil
                             -- Update UI toggle state
                         end
                         return
                     end

                    while machineLoop do -- Loop as long as machineLoop is not nil
                        if player.Character then
                            -- Teleport to the seat CFrame for better positioning
                            player.Character:SetPrimaryPartCFrame(interactSeat.CFrame * CFrame.new(0, 1, 0)) -- Adjust Y offset as needed
                        end

                        local remote = game:GetService("ReplicatedStorage").rEvents.machineInteractRemote
                        local success, err = pcall(function()
                            remote:InvokeServer("useMachine", interactSeat)
                        end)
                         if not success then
                             warn("Error invoking machineInteractRemote:", err)
                         end
                        task.wait(0.1)
                    end
                    -- If the loop stops naturally, uncheck the toggle
                    if machineLoop then
                        machineLoop = nil
                        -- Update UI toggle state
                    end
                end)
            end
        end
    })
end

