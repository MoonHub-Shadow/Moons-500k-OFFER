-- Auto Rebirth (Infinite)
local InfiniteRebirthLoop
local RebirthActive = false
local function setRebirthActive(state)
    RebirthActive = state
    if state then
        InfiniteRebirthLoop = task.spawn(function()
            while RebirthActive do
                local success, err = pcall(function()
                    game:GetService("ReplicatedStorage").rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                end)
                 if not success then
                     warn("Error invoking rebirthRemote:", err)
                 end
                task.wait(0.1)
            end
        end)
    else
        RebirthActive = false
        if InfiniteRebirthLoop then
            task.cancel(InfiniteRebirthLoop)
            InfiniteRebirthLoop = nil
        end
    end
end

