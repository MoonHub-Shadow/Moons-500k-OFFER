-- Fast Rebirth
local FastRebirthLoop
local FastRebirthActive = false
local ToggleFastRebirth = TabAutoRebirth:CreateToggle({
Name = "Auto Fast Rebirth",
CurrentValue = false, -- Added missing comma
Flag = "AutoFastRebirth",
Callback = function(Value)
        FastRebirthActive = Value
        if FastRebirthLoop then
            task.cancel(FastRebirthLoop)
            FastRebirthLoop = nil
        end

        if Value then
            FastRebirthLoop = task.spawn(function()
                local localPlayer = game.Players.LocalPlayer
                local replicatedStorage = game:GetService("ReplicatedStorage")
                local petsFolder = localPlayer:FindFirstChild("petsFolder") -- Use FindFirstChild

                if not petsFolder then
                    warn("petsFolder not found for the local player.")
                    return -- Stop the loop if petsFolder is missing
                end

                -- Function to unequip all pets
                local function unequipAllPets()
                    if petsFolder then
                        for _, petFolder in pairs(petsFolder:GetChildren()) do
                            if petFolder:IsA("Folder") then
                                for _, pet in pairs(petFolder:GetChildren()) do
                                    local success, err = pcall(function()
                                        replicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
                                    end)
                                     if not success then
                                         warn("Error unequipping pet:", err)
                                     end
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end

                -- Function to equip specific pet by name
                local function equipPetByName(petName)
                    unequipAllPets()
                    task.wait(0.01)
                    if petsFolder and petsFolder:FindFirstChild("Unique") then
                        for _, pet in pairs(petsFolder:FindFirstChild("Unique"):GetChildren()) do
                            if pet.Name == petName then
                                 local success, err = pcall(function()
                                     replicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
                                 end)
                                  if not success then
                                      warn("Error equipping pet:", err)
                                  end
                                break -- Stop after finding and equipping the pet
                            end
                        end
                    end
                end

                -- Function to simulate key press "E" (Less reliable in exploits, consider alternative methods if possible)
                local function simulateKeyPress()
                    local virtualInputManager = game:GetService("VirtualInputManager")
                    virtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) -- Use Enum.KeyCode
                    task.wait(0.1)
                    virtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end

                -- Start the loop
                while FastRebirthActive do
                     if not localPlayer or not localPlayer.leaderstats or not localPlayer.leaderstats:FindFirstChild("Rebirths") or not localPlayer.leaderstats:FindFirstChild("Strength") then
                         warn("Player or leaderstats not found, stopping Fast Rebirth.")
                         FastRebirthActive = false -- Stop the loop
                         break
                     end

                    local rebirths = localPlayer.leaderstats.Rebirths.Value
                    local strengthThreshold = 10000 + (5000 * rebirths)

                    if localPlayer.ultimatesFolder and localPlayer.ultimatesFolder:FindFirstChild("Golden Rebirth") then
                        local goldenRebirthValue = localPlayer.ultimatesFolder["Golden Rebirth"].Value
                        strengthThreshold = math.floor(strengthThreshold * (1 - (goldenRebirthValue * 0.1)))
                    end

                    unequipAllPets()
                    task.wait(0.1)
                    equipPetByName("Swift Samurai")

                    -- Repetition until condition met
                    while localPlayer.leaderstats.Strength.Value < strengthThreshold and FastRebirthActive do
                        for _ = 1, 10 do
                             local success, err = pcall(function()
                                 localPlayer.muscleEvent:FireServer("rep")
                             end)
                              if not success then
                                  warn("Error firing muscleEvent:", err)
                              end
                        end
                        task.wait()
                    end

                    if not FastRebirthActive then break end -- Check again before rebirthing

                    task.wait(1) -- Wait before attempting rebirth
                    local success, err = pcall(function()
                         game:GetService("ReplicatedStorage").rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                    end)
                     if not success then
                         warn("Error invoking rebirthRemote:", err)
                     end
                    task.wait(2) -- Wait after rebirthing
                end
            end)
        end
    end,
})

